NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=
# Optional bot protection. Configure both values together to enable Turnstile.
# Without them, forms remain available with rate limiting and honeypot checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
# Optional temporary integration. Configure both values together to scan CVs.
# Without them, valid CVs are accepted with cvScanStatus=notConfigured.
CV_SCAN_ENDPOINT=
CV_SCAN_TOKEN=
