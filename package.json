{
  "name": "sabeel-al-rashid",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node --env-file-if-exists=.env scripts/security-check.mjs --production-only",
    "build": "next build",
    "start": "next start",
    "build-webpack": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:check": "node --env-file-if-exists=.env scripts/security-check.mjs",
    "sanity:typegen": "sanity schema extract --force && sanity typegen generate",
    "seed": "sanity exec scripts/seed.ts && sanity exec scripts/connect-cms.ts",
    "cms:connect": "sanity exec scripts/connect-cms.ts"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.0.2",
    "@vercel/functions": "^3.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "next-sanity": "^13.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.1",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@module-federation/dts-plugin": "2.8.2",
    "smol-toml": "1.7.1",
    "@vercel/frameworks": {
      "js-yaml": "3.15.1"
    },
    "typeid-js": "npm:typeid-js@0.3.0"
  }
}
